# ==============================================================================
# LearnLoop Environment Variables Configuration Template (PostgreSQL)
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your container runtime/cloud platform (e.g. Render, AWS, Docker).
# Never commit actual secrets to Git!

# --- Server & Runtime ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- CORS Cross-Origin Allowlist (for Vercel Frontend Deployment) ---
# Comma-separated list of permitted origins
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173,https://*.vercel.app

# --- PostgreSQL Database Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnloop
DB_USERNAME=learnloop_user
DB_PASSWORD=learnloop_secret
DB_SSL_MODE=prefer

# --- Render PostgreSQL Single URL Support ---
# On Render, when you link a PostgreSQL database, DATABASE_URL is injected automatically
# (e.g. postgres://user:password@dpg-...oregon-postgres.render.com/learnloop).
# LearnLoop automatically detects and parses DATABASE_URL into a PostgreSQL JDBC connection.
# DATABASE_URL=postgres://learnloop_user:learnloop_secret@localhost:5432/learnloop
# DB_URL=jdbc:postgresql://localhost:5432/learnloop?sslmode=require

# --- Apache Kafka Configuration ---
# For local development with KRaft:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=learnloop-group
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
# For Cloud Kafka (e.g. Confluent Cloud, Upstash, Aiven):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="KEY" password="SECRET";

# --- Security & JWT Authentication ---
# MUST be a cryptographically secure random string of at least 256 bits (32+ chars)
JWT_SECRET=LearnLoopSecretKeyMustBeAtLeast256BitsLongForHMACSHA256Security2026!
JWT_EXPIRATION_MS=86400000

# --- Outbox & Scheduled Dispatcher ---
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLLING_RATE_MS=3000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5

# --- Initial Administrator Bootstrap ---
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@learnloop.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@LearnLoop2026!
ADMIN_BOOTSTRAP_NAME=System Administrator
